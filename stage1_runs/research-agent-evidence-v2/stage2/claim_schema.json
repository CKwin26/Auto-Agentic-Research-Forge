{
  "$defs": {
    "StudyArm": {
      "enum": [
        "baseline",
        "treatment"
      ],
      "title": "StudyArm",
      "type": "string"
    },
    "StudyClaim": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "$ref": "#/$defs/StudyArm"
        },
        "artifact_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Artifact Paths",
          "type": "array"
        },
        "claim_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$",
          "title": "Claim Id",
          "type": "string"
        },
        "claim_text": {
          "maxLength": 3000,
          "minLength": 5,
          "title": "Claim Text",
          "type": "string"
        },
        "claim_type": {
          "$ref": "#/$defs/StudyClaimType"
        },
        "experiment_run_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Run Id"
        },
        "metric_values": {
          "additionalProperties": {
            "type": "number"
          },
          "maxProperties": 20,
          "title": "Metric Values",
          "type": "object"
        },
        "run_id": {
          "maxLength": 160,
          "minLength": 3,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seed": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Source Ids",
          "type": "array"
        },
        "task_pack": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$",
          "title": "Task Pack",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "run_id",
        "arm",
        "task_pack",
        "seed",
        "claim_type",
        "claim_text"
      ],
      "title": "StudyClaim",
      "type": "object"
    },
    "StudyClaimType": {
      "enum": [
        "literature",
        "novelty",
        "experiment"
      ],
      "title": "StudyClaimType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arm": {
      "$ref": "#/$defs/StudyArm"
    },
    "cell_id": {
      "title": "Cell Id",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/StudyClaim"
      },
      "maxItems": 40,
      "title": "Claims",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "final_output_text": {
      "default": "",
      "maxLength": 40000,
      "title": "Final Output Text",
      "type": "string"
    },
    "protocol_id": {
      "title": "Protocol Id",
      "type": "string"
    },
    "registry_id": {
      "pattern": "^registry-[0-9a-f]{12}$",
      "title": "Registry Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "task_pack": {
      "title": "Task Pack",
      "type": "string"
    }
  },
  "required": [
    "registry_id",
    "protocol_id",
    "cell_id",
    "run_id",
    "arm",
    "task_pack",
    "seed"
  ],
  "title": "StudyClaimRegistry",
  "type": "object"
}
